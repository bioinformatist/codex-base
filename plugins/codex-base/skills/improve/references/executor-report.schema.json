{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "steps",
    "stoppedBecause",
    "filesChanged",
    "notes"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "STOPPED"
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "stoppedBecause": {
      "type": [
        "string",
        "null"
      ]
    },
    "filesChanged": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    }
  }
}
