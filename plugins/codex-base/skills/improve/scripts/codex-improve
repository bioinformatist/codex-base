#!/usr/bin/env bash
set -euo pipefail
runtime="$(command -v codex-improve || true)"
if [[ -z "$runtime" || ! -x "$runtime" ]]; then
  echo 'codex-improve: install the matching Codex Base native runtime and add its bin directory to PATH' >&2
  exit 2
fi
if [[ "$(readlink -f -- "$runtime")" == "$(readlink -f -- "${BASH_SOURCE[0]}")" ]]; then
  echo 'codex-improve: PATH resolves to this launcher; put the native runtime bin directory first' >&2
  exit 2
fi
CODEX_IMPROVE_SKILL_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
export CODEX_IMPROVE_SKILL_ROOT
exec "$runtime" "$@"
