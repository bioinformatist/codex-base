#!/usr/bin/env bash

set -uo pipefail

# Internal interface: CODEX_PATH DIAGNOSTICS_FILE. The caller owns and protects
# DIAGNOSTICS_FILE; this helper appends native stderr and failed RPC envelopes.
[ "$#" -eq 2 ] || {
  echo 'Spark availability query: invalid invocation' >&2
  exit 2
}
codex_path="$1"
diagnostics_file="$2"
[ -x "$codex_path" ] || {
  echo 'Spark availability query: Codex executable is not executable' >&2
  exit 2
}
: >>"$diagnostics_file" || {
  echo 'Spark availability query: diagnostics file is not writable' >&2
  exit 2
}

app_pid=""
app_in=""
app_out=""
current_operation="startup"
cleanup_started=0

cleanup() {
  [ "$cleanup_started" -eq 0 ] || return
  cleanup_started=1
  trap - EXIT INT TERM
  if [ -n "$app_in" ]; then
    exec {app_in}>&- 2>/dev/null || true
    app_in=""
  fi
  if [ -n "$app_out" ]; then
    exec {app_out}<&- 2>/dev/null || true
    app_out=""
  fi
  if [ -n "$app_pid" ]; then
    if kill -0 "$app_pid" 2>/dev/null; then
      kill -TERM "$app_pid" 2>/dev/null || true
      for _ in {1..20}; do
        kill -0 "$app_pid" 2>/dev/null || break
        sleep 0.05
      done
      if kill -0 "$app_pid" 2>/dev/null; then
        kill -KILL "$app_pid" 2>/dev/null || true
      fi
    fi
    wait "$app_pid" 2>/dev/null || true
    app_pid=""
  fi
}

fail_query() {
  printf 'Spark availability query failed during %s: %s\n' "$1" "$2" >&2
  exit 1
}

handle_signal() {
  local detail="$1" status="$2"
  printf 'Spark availability query failed during %s: %s\n' \
    "$current_operation" "$detail" >&2
  exit "$status"
}

record_native_failure() {
  local operation="$1" reason="$2" envelope="${3-}"
  if [ -n "$envelope" ]; then
    printf 'operation=%s reason=%s envelope=%s\n' \
      "$operation" "$reason" "$envelope" >>"$diagnostics_file" 2>/dev/null || true
  else
    printf 'operation=%s reason=%s\n' \
      "$operation" "$reason" >>"$diagnostics_file" 2>/dev/null || true
  fi
}

trap cleanup EXIT
trap 'handle_signal interrupted 130' INT
trap 'handle_signal timeout 124' TERM

# exec makes APP_SERVER_PID the actual app-server process, so cleanup always
# closes the protocol descriptors and reaps the process it started.
coproc APP_SERVER { exec "$codex_path" app-server 2>>"$diagnostics_file"; }
app_pid="$APP_SERVER_PID"
app_out="${APP_SERVER[0]}"
app_in="${APP_SERVER[1]}"

rpc_result=""
rpc() {
  local id="$1" method="$2" params="$3" line
  current_operation="$method"
  if ! printf '{"id":%s,"method":%s,"params":%s}\n' \
    "$id" "$(jq -Rn --arg value "$method" '$value')" "$params" >&"$app_in"; then
    record_native_failure "$method" write-failed
    fail_query "$method" 'native transport write failed'
  fi

  while IFS= read -r line <&"$app_out"; do
    if ! jq -e 'type == "object"' <<<"$line" >/dev/null 2>&1; then
      record_native_failure "$method" malformed-envelope "$line"
      fail_query "$method" 'malformed native response'
    fi
    if ! jq -e 'has("id")' <<<"$line" >/dev/null; then
      if jq -e 'has("result") or has("error") or (.method | type != "string")' \
        <<<"$line" >/dev/null; then
        record_native_failure "$method" malformed-notification "$line"
        fail_query "$method" 'malformed native notification'
      fi
      continue
    fi
    if ! jq -e --argjson expected "$id" '.id == $expected' \
      <<<"$line" >/dev/null; then
      record_native_failure "$method" unexpected-response-id "$line"
      fail_query "$method" 'unexpected native response id'
    fi
    if ! jq -e 'has("result") != has("error")' <<<"$line" >/dev/null; then
      record_native_failure "$method" malformed-response "$line"
      fail_query "$method" 'malformed native response'
    fi
    if jq -e 'has("error")' <<<"$line" >/dev/null; then
      if ! jq -e '.error | type == "object" and (.message | type == "string")' \
        <<<"$line" >/dev/null; then
        record_native_failure "$method" malformed-error "$line"
        fail_query "$method" 'malformed native error'
      fi
      record_native_failure "$method" rpc-error "$line"
      fail_query "$method" 'native RPC error'
    fi
    rpc_result="$(jq -c '.result' <<<"$line")" || {
      record_native_failure "$method" malformed-result "$line"
      fail_query "$method" 'malformed native result'
    }
    return
  done

  record_native_failure "$method" unexpected-eof
  fail_query "$method" 'unexpected native EOF'
}

rpc 1 initialize \
  '{"clientInfo":{"name":"codex-improve","title":null,"version":"1.0.0-codex.16"},"capabilities":null}'
jq -e 'type == "object"' <<<"$rpc_result" >/dev/null 2>&1 || {
  record_native_failure initialize malformed-result "$rpc_result"
  fail_query initialize 'malformed native result'
}

current_operation=initialized
printf '%s\n' '{"method":"initialized","params":{}}' >&"$app_in" || {
  record_native_failure initialized write-failed
  fail_query initialized 'native transport write failed'
}

rpc 2 account/read '{}'
account="$rpc_result"
if ! jq -e '
  type == "object"
  and (
    .account == null
    or (
      (.account | type == "object")
      and (.account.type | type == "string")
      and (.account.type as $account_type
           | (["chatgpt", "apiKey", "amazonBedrock"]
              | index($account_type) != null))
    )
  )
' <<<"$account" >/dev/null 2>&1; then
  record_native_failure account/read malformed-result "$account"
  fail_query account/read 'malformed native result'
fi
account_type="$(jq -r '.account.type // empty' <<<"$account")"
case "$account_type" in
  apiKey | amazonBedrock)
    echo luna
    exit 0
    ;;
  chatgpt | '') ;;
  *)
    record_native_failure account/read malformed-result "$account"
    fail_query account/read 'malformed native result'
    ;;
esac

models='[]'
cursor=null
seen_cursors='[]'
id=3
while :; do
  params="$(jq -nc --argjson cursor "$cursor" \
    '{cursor:$cursor,limit:100,includeHidden:true}')" ||
    fail_query model/list 'cannot construct native request'
  rpc "$id" model/list "$params"
  page="$rpc_result"
  if ! jq -e '
    type == "object"
    and (.data | type == "array")
    and (.nextCursor == null or (.nextCursor | type == "string"))
    and all(.data[]; type == "object" and (.model | type == "string"))
  ' <<<"$page" >/dev/null 2>&1; then
    record_native_failure model/list malformed-result "$page"
    fail_query model/list 'malformed native result'
  fi
  models="$(jq -nc --argjson accumulated "$models" --argjson page "$page" \
    '$accumulated + $page.data')" || fail_query model/list 'cannot process native result'
  cursor="$(jq -c '.nextCursor' <<<"$page")" ||
    fail_query model/list 'cannot process native result'
  [ "$cursor" != null ] || break
  if jq -e --argjson cursor "$cursor" 'index($cursor) != null' \
    <<<"$seen_cursors" >/dev/null; then
    record_native_failure model/list repeated-cursor "$page"
    fail_query model/list 'repeated native pagination cursor'
  fi
  seen_cursors="$(jq -nc --argjson seen "$seen_cursors" --argjson cursor "$cursor" \
    '$seen + [$cursor]')" || fail_query model/list 'cannot process native result'
  id="$((id + 1))"
done

if jq -e 'any(.[]; .model == "gpt-5.3-codex-spark")' <<<"$models" >/dev/null; then
  if ! jq -e '
    all(
      .[] | select(.model == "gpt-5.3-codex-spark");
      (.hidden | type == "boolean")
      and (.supportedReasoningEfforts | type == "array")
      and all(.supportedReasoningEfforts[]; type == "object" and (.reasoningEffort | type == "string"))
    )
  ' <<<"$models" >/dev/null; then
    record_native_failure model/list malformed-spark-metadata "$models"
    fail_query model/list 'malformed native result'
  fi

  if ! jq -e '
    any(
      .[] | select(.model == "gpt-5.3-codex-spark" );
      .hidden == false
      and any(.supportedReasoningEfforts[]; .reasoningEffort == "high")
    )
  ' <<<"$models" >/dev/null; then
    echo luna
    exit 0
  fi
else
  echo luna
  exit 0
fi

id="$((id + 1))"
rpc "$id" account/rateLimits/read '{}'
limits="$rpc_result"
if ! jq -e '
  type == "object"
  and (.rateLimitsByLimitId == null or (.rateLimitsByLimitId | type == "object"))
' <<<"$limits" >/dev/null 2>&1; then
  record_native_failure account/rateLimits/read malformed-result "$limits"
  fail_query account/rateLimits/read 'malformed native result'
fi

if jq -e '(.rateLimitsByLimitId // {}) | has("codex_bengalfox")' <<<"$limits" >/dev/null; then
  if ! jq -e '
    .rateLimitsByLimitId.codex_bengalfox
    | type == "object"
    and (.primary == null or (
      .primary | type == "object" and (.usedPercent | type == "number")
    ))
    and (.secondary == null or (
      .secondary | type == "object" and (.usedPercent | type == "number")
    ))
    and (.spendControlReached == null or (.spendControlReached | type == "boolean"))
    and (.rateLimitReachedType == null or (.rateLimitReachedType | type == "string"))
  ' <<<"$limits" >/dev/null; then
    record_native_failure account/rateLimits/read malformed-result "$limits"
    fail_query account/rateLimits/read 'malformed native result'
  fi
fi

selection="$(jq -r '
  .rateLimitsByLimitId.codex_bengalfox as $snapshot
  | if $snapshot == null then
      "luna"
    else
      ([
        $snapshot.primary,
        $snapshot.secondary
      ] | map(select(. != null)) as $windows
      | if ($windows | length) == 0 then
          "luna"
        elif all($windows[]; .usedPercent < 100)
          and $snapshot.spendControlReached != true
          and $snapshot.rateLimitReachedType == null then
          "spark"
        else
          "luna"
        end)
    end
' <<<"$limits")" || fail_query account/rateLimits/read 'cannot process native result'
printf '%s\n' "$selection"
