{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Improve review verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "summary",
    "findings",
    "coverage",
    "review_blockers",
    "deferred_acceptance"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "description": "Current implementation review only. APPROVE requires no findings or review blockers and PASS for every coverage entry. Deferred acceptance may remain pending.",
      "enum": [
        "APPROVE",
        "REVISE",
        "BLOCK"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check",
          "severity",
          "location",
          "claim",
          "evidence",
          "action"
        ],
        "properties": {
          "check": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "description": "Checks required for the current implementation review. Put later CI, integration or physical acceptance only in deferred_acceptance; do not duplicate them here as BLOCKED.",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check",
          "status",
          "evidence"
        ],
        "properties": {
          "check": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "review_blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item",
          "impact"
        ],
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "impact": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "deferred_acceptance": {
      "type": "array",
      "description": "Later checks explicitly deferred by the approved plan. These may remain pending with an APPROVE verdict; missing current implementation evidence belongs in coverage or review_blockers instead.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check",
          "owner",
          "reason",
          "evidence_required"
        ],
        "properties": {
          "check": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence_required": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
